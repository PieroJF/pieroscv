{
  "name": "pieroscv",
  "compatibility_date": "2026-07-27",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [
    { "pattern": "pieroscv.com", "custom_domain": true },
    { "pattern": "www.pieroscv.com", "custom_domain": true }
  ]
}
