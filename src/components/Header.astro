---
const links = [
  { href: '/projects', label: 'Projects' },
  { href: '/blog', label: 'Blog' },
  { href: '/cv', label: 'CV' },
];
const current = Astro.url.pathname;
---
<header class="mx-auto max-w-5xl px-6 pt-8">
  <nav aria-label="Main navigation" class="flex items-baseline justify-between border-b border-(--color-hairline) pb-4">
    <a href="/" class="font-(family-name:--font-display) text-lg font-semibold tracking-tight">PF<span class="text-(--color-accent)">.</span></a>
    <ul class="flex gap-6 text-sm">
      {links.map((l) => (
        <li>
          <a
            href={l.href}
            aria-current={current.startsWith(l.href) ? 'page' : undefined}
            class:list={[
              'border-b-2 pb-1 transition-colors hover:text-(--color-accent)',
              current.startsWith(l.href)
                ? 'border-(--color-accent) font-semibold text-(--color-ink)'
                : 'border-transparent',
            ]}
          >{l.label}</a>
        </li>
      ))}
    </ul>
  </nav>
</header>
