---
import Base from '../layouts/Base.astro';
---
<Base title="404 — Piero Flores" description="Page not found.">
  <section class="pt-24">
    <p class="tabular text-2xl font-bold text-(--color-accent)">404</p>
    <h1 class="mt-3 font-(family-name:--font-display) text-4xl font-bold tracking-tight">Out of tolerance.</h1>
    <p class="mt-3 max-w-xl text-(--color-muted)">This page does not exist — a deviation beyond any acceptable uncertainty budget.</p>
    <p class="mt-8"><a class="text-(--color-ink) underline decoration-(--color-accent) underline-offset-2 transition-colors hover:text-(--color-accent)" href="/">← Back to home</a></p>
  </section>
</Base>
