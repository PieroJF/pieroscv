---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { formatDate } from '../../lib/format';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---
<Base
  title="Blog — Piero Flores"
  description="Technical notes on robotics, kinematics, metrology and automation."
>
  <section class="pt-16">
    <h1 class="font-(family-name:--font-display) text-4xl font-bold tracking-tight">Blog</h1>
    <p class="mt-3 max-w-2xl text-(--color-muted)">Technical notes on robotics, metrology and automation.</p>
  </section>
  <ul class="mt-12 space-y-8">
    {posts.map((post) => (
      <li class="rule pt-5">
        <p class="tabular text-sm text-(--color-accent)">
          <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
        </p>
        <h2 class="mt-1 font-(family-name:--font-display) text-xl font-semibold tracking-tight">
          <a class="hover:text-(--color-accent) transition-colors" href={`/blog/${post.id}`}>{post.data.title}</a>
        </h2>
        <p class="mt-2 max-w-3xl text-sm leading-relaxed text-(--color-muted)">{post.data.description}</p>
      </li>
    ))}
  </ul>
</Base>
